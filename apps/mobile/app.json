{
  "expo": {
    "name": "See U Around",
    "slug": "seeuaround",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "seeuaround",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seeuaround.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.seeuaround.app",
      "adaptiveIcon": {
        "backgroundColor": "#090807",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a friend's code to connect."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090807",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#DF8B32"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Leave a voice note for the people on this night.",
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.seeuaround.com",
      "router": {},
      "eas": {
        "projectId": "e3d892bc-2e77-4280-8ac5-a12f8ee06641"
      }
    },
    "owner": "sympals"
  }
}
