{
  "expo": {
    "name": "See U Around",
    "slug": "seeuaround",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "seeuaround",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14161A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.seeuaround.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.seeuaround.app",
      "adaptiveIcon": {
        "backgroundColor": "#14161A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F3C267"
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://api.seeuaround.com",
      "router": {},
      "eas": {
        "projectId": "e3d892bc-2e77-4280-8ac5-a12f8ee06641"
      }
    },
    "owner": "sympals"
  }
}
